# Optional default secret key (nsec) for the browser session.
# Leave empty to sign with a NIP-07 extension or a generated key instead.
NEXT_PUBLIC_DEFAULT_NOSTR_USER_SK=

# Default relay the app connects to. Poseidon-class proofs are ~160 KB
# events — pick a relay with raised limits, or your own (see
# ../config/nostr-rs-relay/config.toml).
NEXT_PUBLIC_DEFAULT_RELAYER="wss://relay.damus.io"

# Restrict the marketplace to a single DVM provider pubkey (hex).
# Leave empty for the open market.
NEXT_PUBLIC_DVM_PUBKEY=
